{
  "$schema": "https://raw.githubusercontent.com/uniqueg/ga4gh-io-schema/v0.3.0/schemas/ga4gh-io-profile.schema.json",
  "$id": "https://example.org/schemas/ui-widgets",
  "title": "Valid: ui-widgets",
  "description": "Every widget of the vocabulary on a schema that it fits, including nullable types, a multi-select dropdown, nested inputs and a custom widget.",
  "type": "object",
  "properties": {
    "inputs": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "x-ga4gh-ui-widget": "text"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "x-ga4gh-ui-widget": "textarea"
        },
        "threads": {
          "type": "integer",
          "minimum": 1,
          "x-ga4gh-ui-widget": "number"
        },
        "quality": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1,
          "x-ga4gh-ui-widget": "slider"
        },
        "genome": {
          "type": "string",
          "enum": [
            "GRCh38",
            "GRCm39"
          ],
          "x-ga4gh-ui-widget": "dropdown"
        },
        "stages": {
          "type": "array",
          "items": {
            "enum": [
              "trim",
              "align",
              "count"
            ]
          },
          "uniqueItems": true,
          "x-ga4gh-ui-widget": "dropdown"
        },
        "species": {
          "type": "string",
          "examples": [
            "Homo sapiens",
            "Mus musculus"
          ],
          "x-ga4gh-ui-widget": "typeahead"
        },
        "assay": {
          "type": "string",
          "enum": [
            "RNA-seq",
            "ATAC-seq"
          ],
          "x-ga4gh-ui-widget": "typeahead"
        },
        "strand": {
          "enum": [
            "forward",
            "reverse",
            "unstranded"
          ],
          "x-ga4gh-ui-widget": "radio"
        },
        "paired": {
          "type": "boolean",
          "x-ga4gh-ui-widget": "checkbox"
        },
        "verbose": {
          "type": "boolean",
          "default": false,
          "x-ga4gh-ui-widget": "switch"
        },
        "date": {
          "type": "string",
          "format": "date",
          "x-ga4gh-ui-widget": "date-picker"
        },
        "start": {
          "type": "string",
          "format": "time",
          "x-ga4gh-ui-widget": "time-picker"
        },
        "deadline": {
          "type": "string",
          "format": "date-time",
          "x-ga4gh-ui-widget": "datetime-picker"
        },
        "colour": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "x-ga4gh-ui-widget": "color-picker"
        },
        "reads": {
          "type": "string",
          "x-ga4gh-file": {
            "kind": "file"
          },
          "x-ga4gh-ui-widget": "file-picker"
        },
        "index": {
          "type": "string",
          "x-ga4gh-file": {
            "kind": "directory"
          },
          "x-ga4gh-ui-widget": "directory-picker"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-ga4gh-ui-widget": "tags"
        },
        "advanced": {
          "type": "object",
          "properties": {
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99,
              "x-ga4gh-ui-widget": "slider"
            }
          }
        },
        "layout": {
          "type": "string",
          "x-ga4gh-ui-widget": "custom:my-widget"
        }
      }
    },
    "outputs": {
      "type": "object",
      "properties": {
        "report": {
          "type": "string",
          "x-ga4gh-file": {
            "kind": "file"
          },
          "x-ga4gh-ui-widget": "html-viewer"
        },
        "counts": {
          "type": "array",
          "items": {
            "type": "string",
            "x-ga4gh-file": {
              "kind": "file",
              "mediaType": "text/csv"
            },
            "x-ga4gh-ui-widget": "table-viewer"
          }
        },
        "summary": {
          "type": "string",
          "x-ga4gh-ui-widget": "custom:my-viewer"
        }
      }
    }
  }
}
