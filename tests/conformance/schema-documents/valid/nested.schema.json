{
  "$schema": "https://raw.githubusercontent.com/uniqueg/ga4gh-io-schema/v0.3.0/schemas/ga4gh-io-profile.schema.json",
  "$id": "https://example.org/schemas/nested.schema.json",
  "$comment": "Deeply nested parameters: an array of arrays, 8 levels deep, and records nested 4 levels deep with 2 or 3 fields each. A validator that evaluates nested schemas several times per level takes time exponential in the depth here.",
  "type": "object",
  "properties": {
    "inputs": {
      "type": "object",
      "properties": {
        "reads": {
          "type": "array",
          "x-ga4gh-parameter": { "type": "File[][][][][][][][]" },
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "x-ga4gh-file": { "kind": "file" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "settings": {
          "type": "object",
          "x-ga4gh-parameter": { "type": "record" },
          "properties": {
            "a": { "$ref": "#/$defs/level1" },
            "b": { "$ref": "#/$defs/level1" },
            "c": { "$ref": "#/$defs/level1" }
          }
        }
      }
    }
  },
  "$defs": {
    "level1": {
      "type": "object",
      "x-ga4gh-hidden": false,
      "properties": {
        "a": {
          "type": "object",
          "properties": {
            "a": {
              "type": "object",
              "properties": {
                "a": { "type": "string", "x-ga4gh-hidden": true },
                "b": { "type": "integer", "x-ga4gh-ui-widget": "number" },
                "c": { "type": "boolean", "x-ga4gh-ui-widget": "checkbox" }
              }
            },
            "b": {
              "type": "object",
              "properties": {
                "a": { "type": "string", "x-ga4gh-hidden": true },
                "b": { "type": "integer", "x-ga4gh-ui-widget": "number" },
                "c": { "type": "boolean", "x-ga4gh-ui-widget": "checkbox" }
              }
            },
            "c": {
              "type": "object",
              "properties": {
                "a": { "type": "string", "x-ga4gh-hidden": true },
                "b": { "type": "integer", "x-ga4gh-ui-widget": "number" },
                "c": { "type": "boolean", "x-ga4gh-ui-widget": "checkbox" }
              }
            }
          }
        },
        "b": {
          "type": "object",
          "properties": {
            "a": {
              "type": "object",
              "properties": {
                "a": { "type": "string", "x-ga4gh-hidden": true },
                "b": { "type": "integer", "x-ga4gh-ui-widget": "number" },
                "c": { "type": "boolean", "x-ga4gh-ui-widget": "checkbox" }
              }
            },
            "b": {
              "type": "object",
              "properties": {
                "a": { "type": "string", "x-ga4gh-hidden": true },
                "b": { "type": "integer", "x-ga4gh-ui-widget": "number" },
                "c": { "type": "boolean", "x-ga4gh-ui-widget": "checkbox" }
              }
            },
            "c": {
              "type": "object",
              "properties": {
                "a": { "type": "string", "x-ga4gh-hidden": true },
                "b": { "type": "integer", "x-ga4gh-ui-widget": "number" },
                "c": { "type": "boolean", "x-ga4gh-ui-widget": "checkbox" }
              }
            }
          }
        }
      }
    }
  }
}
