{
  "$schema": "https://raw.githubusercontent.com/uniqueg/ga4gh-io-schema/v0.3.0/schemas/ga4gh-io-profile.schema.json",
  "$id": "https://example.org/schemas/invalid/file-scheme-bad",
  "title": "Invalid: file-scheme-bad",
  "description": "A file reference allows the javascript scheme.",
  "type": "object",
  "properties": {
    "inputs": {
      "type": "object",
      "properties": {
        "reads": {
          "type": "string",
          "x-ga4gh-file": {
            "kind": "file",
            "schemes": [
              "https",
              "javascript"
            ]
          }
        }
      }
    }
  }
}
