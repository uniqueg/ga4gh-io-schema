{
  "$schema": "https://raw.githubusercontent.com/uniqueg/ga4gh-io-schema/v0.3.0/schemas/ga4gh-io-profile.schema.json",
  "$id": "https://example.org/schemas/invalid/file-unknown-key",
  "title": "Invalid: file-unknown-key",
  "description": "A file reference has a key that the annotation doesn't define.",
  "type": "object",
  "properties": {
    "inputs": {
      "type": "object",
      "properties": {
        "reads": {
          "type": "string",
          "x-ga4gh-file": {
            "kind": "file",
            "mimetype": "text/csv"
          }
        }
      }
    }
  }
}
