{
  "$schema": "https://raw.githubusercontent.com/uniqueg/ga4gh-io-schema/v0.3.0/schemas/ga4gh-io-profile.schema.json",
  "$id": "https://example.org/schemas/draft-keyword-nested-deep.schema.json",
  "$comment": "A schema nested deep in arrays of records breaks Draft 2020-12: minLength must be a non-negative integer.",
  "properties": {
    "inputs": {
      "type": "object",
      "properties": {
        "samples": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "reads": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": -1
                }
              }
            }
          }
        }
      }
    }
  }
}
