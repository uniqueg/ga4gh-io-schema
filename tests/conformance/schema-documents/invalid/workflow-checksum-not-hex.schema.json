{
  "$schema": "https://raw.githubusercontent.com/uniqueg/ga4gh-io-schema/v0.3.0/schemas/ga4gh-io-profile.schema.json",
  "$id": "https://example.org/schemas/invalid/workflow-checksum-not-hex",
  "title": "Invalid: workflow-checksum-not-hex",
  "description": "The checksum of the primary descriptor isn't hex-encoded.",
  "type": "object",
  "x-ga4gh-workflow": {
    "descriptor_type": "WDL",
    "entry_point": "align",
    "checksum": [
      {
        "type": "sha-256",
        "checksum": "not-hex"
      }
    ]
  },
  "properties": {
    "inputs": {
      "type": "object",
      "properties": {
        "sample_id": {
          "type": "string"
        }
      }
    }
  }
}
