{
  "$schema": "https://raw.githubusercontent.com/uniqueg/ga4gh-io-schema/v0.3.0/schemas/ga4gh-io-profile.schema.json",
  "$id": "https://example.org/schemas/draft-keyword-in-tabular.schema.json",
  "$comment": "A column of a tabular schema breaks Draft 2020-12: type must name a type.",
  "properties": {
    "inputs": {
      "type": "object",
      "properties": {
        "sample_sheet": {
          "type": "string",
          "x-ga4gh-file": {
            "kind": "file",
            "mediaType": "text/csv"
          },
          "x-ga4gh-tabular-schema": {
            "type": "object",
            "properties": {
              "condition": {
                "type": "text"
              }
            }
          }
        }
      }
    }
  }
}
