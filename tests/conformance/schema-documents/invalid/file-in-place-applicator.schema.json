{
  "$schema": "https://raw.githubusercontent.com/uniqueg/ga4gh-io-schema/v0.3.0/schemas/ga4gh-io-profile.schema.json",
  "$id": "https://example.org/schemas/invalid/file-in-place-applicator",
  "title": "Invalid: file-in-place-applicator",
  "description": "A file reference brings format: uri back through allOf.",
  "type": "object",
  "properties": {
    "inputs": {
      "type": "object",
      "properties": {
        "reads": {
          "type": "string",
          "allOf": [
            {
              "format": "uri"
            }
          ],
          "x-ga4gh-file": {
            "kind": "file"
          }
        }
      }
    }
  }
}
