{
  "$schema": "https://raw.githubusercontent.com/uniqueg/ga4gh-io-schema/v0.3.0/schemas/ga4gh-io-profile.schema.json",
  "$id": "https://example.org/schemas/invalid/output-glob-items-not-file",
  "title": "Invalid: output-glob-items-not-file",
  "description": "An output glob is on a list whose items are not file references.",
  "type": "object",
  "properties": {
    "inputs": {
      "type": "object"
    },
    "outputs": {
      "type": "object",
      "properties": {
        "report": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-ga4gh-output-glob": "logs/*.txt"
        }
      }
    }
  }
}
