{
  "$schema": "https://raw.githubusercontent.com/uniqueg/ga4gh-io-schema/v0.3.0/schemas/ga4gh-io-profile.schema.json",
  "$id": "https://example.org/schemas/invalid/ui-widget-ref-only",
  "title": "Invalid: ui-widget-ref-only",
  "description": "The slider widget gets its type and bounds only through $ref, not in the schema that carries it.",
  "type": "object",
  "properties": {
    "inputs": {
      "type": "object",
      "properties": {
        "level": {
          "$ref": "#/$defs/count",
          "x-ga4gh-ui-widget": "slider"
        }
      }
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    }
  }
}
