{
  "$schema": "https://raw.githubusercontent.com/uniqueg/ga4gh-io-schema/v0.3.0/schemas/ga4gh-io-profile.schema.json",
  "$id": "https://example.org/schemas/variant-calling/smk/1.0.0",
  "x-ga4gh-workflow": {
    "descriptor_type": "SMK"
  },
  "type": "object",
  "properties": {
    "inputs": {
      "type": "object",
      "properties": {}
    },
    "outputs": {
      "type": "object",
      "properties": {
        "calls": {
          "type": "array",
          "items": {
            "type": "string",
            "x-ga4gh-file": {
              "kind": "file",
              "secondaryFiles": [
                ".tbi"
              ]
            }
          },
          "x-ga4gh-output-glob": "results/calls/*.vcf.gz"
        },
        "report": {
          "type": "string",
          "x-ga4gh-file": {
            "kind": "file",
            "mediaType": "text/html"
          },
          "x-ga4gh-output-glob": "results/report.html"
        }
      },
      "additionalProperties": false,
      "required": [
        "calls",
        "report"
      ]
    }
  }
}
