{
  "$schema": "https://raw.githubusercontent.com/uniqueg/ga4gh-io-schema/v0.3.0/schemas/ga4gh-io-profile.schema.json",
  "$id": "https://example.org/schemas/rna-seq-qc/cwl/1.0.0",
  "x-ga4gh-workflow": {
    "descriptor_type": "CWL",
    "descriptor_type_version": "v1.2"
  },
  "type": "object",
  "properties": {
    "inputs": {
      "type": "object",
      "properties": {}
    },
    "outputs": {
      "type": "object",
      "properties": {
        "qc_report": {
          "type": "string",
          "x-ga4gh-file": {
            "kind": "file",
            "mediaType": "text/html"
          },
          "x-ga4gh-output-glob": "multiqc_report.html"
        },
        "alignments": {
          "type": "array",
          "items": {
            "type": "string",
            "x-ga4gh-file": {
              "kind": "file",
              "secondaryFiles": [
                ".bai"
              ]
            }
          },
          "x-ga4gh-output-glob": "*.bam"
        },
        "gene_counts": {
          "type": "string",
          "x-ga4gh-file": {
            "kind": "directory"
          },
          "x-ga4gh-output-glob": "counts"
        },
        "samples_passed_qc": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "qc_report",
        "alignments"
      ]
    }
  }
}
