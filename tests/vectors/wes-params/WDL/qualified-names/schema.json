{
  "$schema": "https://raw.githubusercontent.com/uniqueg/ga4gh-io-schema/v0.3.0/schemas/ga4gh-io-profile.schema.json",
  "$id": "https://example.org/schemas/vectors/wdl/1.0.0",
  "x-ga4gh-workflow": {
    "descriptor_type": "WDL",
    "descriptor_type_version": "1.1",
    "entry_point": "variant_calling"
  },
  "type": "object",
  "properties": {
    "inputs": {
      "type": "object",
      "properties": {
        "input_bam": {
          "type": "string",
          "x-ga4gh-file": {
            "kind": "file",
            "secondaryFiles": [
              ".bai"
            ]
          },
          "x-ga4gh-parameter": {
            "type": "File"
          }
        },
        "sample_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "x-ga4gh-parameter": {
            "type": "Array[String]+"
          }
        },
        "caller_threads": {
          "type": "integer",
          "minimum": 1,
          "default": 4,
          "x-ga4gh-parameter": {
            "name": "call_variants.threads",
            "type": "Int"
          }
        }
      },
      "required": [
        "input_bam",
        "sample_names"
      ],
      "additionalProperties": false
    }
  }
}
