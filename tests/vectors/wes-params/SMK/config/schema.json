{
  "$schema": "https://raw.githubusercontent.com/uniqueg/ga4gh-io-schema/v0.3.0/schemas/ga4gh-io-profile.schema.json",
  "$id": "https://example.org/schemas/vectors/smk/1.0.0",
  "x-ga4gh-workflow": {
    "descriptor_type": "SMK",
    "descriptor_type_version": "8"
  },
  "type": "object",
  "properties": {
    "inputs": {
      "type": "object",
      "properties": {
        "reference": {
          "type": "object",
          "properties": {
            "fasta": {
              "type": "string",
              "x-ga4gh-file": {
                "kind": "file"
              }
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "fasta"
          ]
        },
        "samples": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "bam": {
                "type": "string",
                "x-ga4gh-file": {
                  "kind": "file"
                }
              }
            }
          }
        },
        "threads": {
          "type": "integer"
        }
      },
      "required": [
        "reference"
      ],
      "additionalProperties": false
    }
  }
}
