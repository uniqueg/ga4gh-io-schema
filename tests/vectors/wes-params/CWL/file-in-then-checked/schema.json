{
  "$schema": "https://raw.githubusercontent.com/uniqueg/ga4gh-io-schema/v0.3.0/schemas/ga4gh-io-profile.schema.json",
  "$id": "https://example.org/schemas/vectors/cwl/1.0.0",
  "x-ga4gh-workflow": {
    "descriptor_type": "CWL",
    "descriptor_type_version": "v1.2"
  },
  "type": "object",
  "properties": {
    "inputs": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string"
        },
        "reads": {
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "mode": {
            "const": "a"
          }
        }
      },
      "then": {
        "properties": {
          "reads": {
            "type": "string",
            "x-ga4gh-file": {
              "kind": "file"
            }
          }
        }
      }
    }
  }
}
