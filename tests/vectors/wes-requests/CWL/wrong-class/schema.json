{
  "$schema": "https://raw.githubusercontent.com/elixir-cloud-aai/ga4gh-io-schema/main/schemas/ga4gh-io-profile.schema.json",
  "$id": "https://example.org/schemas/vectors/cwl/1.0.0",
  "x-ga4gh-workflow": {
    "descriptor_type": "CWL",
    "descriptor_type_version": "v1.2"
  },
  "type": "object",
  "properties": {
    "inputs": {
      "type": "object",
      "properties": {
        "reads": {
          "type": "string",
          "x-ga4gh-file": {
            "kind": "file",
            "secondaryFiles": [
              "^.bai"
            ]
          }
        },
        "index": {
          "type": "string",
          "x-ga4gh-file": {
            "kind": "directory"
          }
        },
        "fastqs": {
          "type": "array",
          "items": {
            "type": "string",
            "x-ga4gh-file": {
              "kind": "file"
            }
          }
        },
        "samples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sample"
          }
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "reads"
      ],
      "additionalProperties": false
    }
  },
  "$defs": {
    "sample": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "bam": {
          "type": "string",
          "x-ga4gh-file": {
            "kind": "file"
          }
        }
      },
      "required": [
        "id",
        "bam"
      ]
    }
  }
}
