{
  "$schema": "https://raw.githubusercontent.com/uniqueg/ga4gh-io-schema/v0.3.0/schemas/ga4gh-io-profile.schema.json",
  "$id": "https://example.org/schemas/invalid/file-in-outputs",
  "title": "Invalid: file-in-outputs",
  "description": "A file reference of an output doesn't say whether it is a file or a directory.",
  "type": "object",
  "properties": {
    "inputs": {
      "type": "object"
    },
    "outputs": {
      "type": "object",
      "properties": {
        "reads": {
          "type": "string",
          "x-ga4gh-file": {
            "compression": "gzip"
          }
        }
      }
    }
  }
}
