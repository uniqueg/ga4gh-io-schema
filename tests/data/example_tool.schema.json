{
  "$schema": "https://raw.githubusercontent.com/uniqueg/ga4gh-io-schema/v0.3.0/schemas/ga4gh-io-profile.schema.json",
  "$id": "https://example.org/schemas/bwa-mem/cwl/0.7.17",
  "title": "BWA MEM Aligner",
  "description": "Burrows-Wheeler Aligner for short read mapping.",
  "x-ga4gh-workflow": {
    "trs_tool_id": "#tool/example.org/bwa-mem",
    "trs_version_id": "0.7.17",
    "descriptor_type": "CWL",
    "descriptor_type_version": "v1.2",
    "primary_descriptor_path": "bwa-mem.cwl"
  },
  "type": "object",
  "properties": {
    "inputs": {
      "type": "object",
      "properties": {
        "reference_fasta": {
          "type": "string",
          "title": "Reference FASTA",
          "description": "Reference genome, indexed with bwa index; the five index files lie next to it.",
          "x-ga4gh-file": {
            "kind": "file",
            "ontology": "http://edamontology.org/format_1929",
            "secondaryFiles": [".amb", ".ann", ".bwt", ".pac", ".sa"]
          }
        },
        "read_1": {
          "type": "string",
          "title": "Read 1 FASTQ",
          "x-ga4gh-file": {
            "kind": "file",
            "ontology": "http://edamontology.org/format_1930",
            "compression": "gzip"
          }
        },
        "read_2": {
          "type": "string",
          "title": "Read 2 FASTQ",
          "description": "Mates of read_1, for paired-end reads.",
          "x-ga4gh-file": {
            "kind": "file",
            "ontology": "http://edamontology.org/format_1930",
            "compression": "gzip"
          }
        },
        "threads": {
          "type": "integer",
          "minimum": 1,
          "default": 4,
          "title": "CPU Threads"
        }
      },
      "required": ["reference_fasta", "read_1"],
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "properties": {
        "alignment_bam": {
          "type": "string",
          "title": "Aligned BAM",
          "x-ga4gh-file": {
            "kind": "file",
            "ontology": "http://edamontology.org/format_2572"
          }
        }
      }
    }
  }
}
