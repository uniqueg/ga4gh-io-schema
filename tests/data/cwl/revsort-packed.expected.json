{
  "$schema": "https://raw.githubusercontent.com/uniqueg/ga4gh-io-schema/v0.3.0/schemas/ga4gh-io-profile.schema.json",
  "description": "Reverse the lines in a document, then sort those lines.",
  "type": "object",
  "properties": {
    "inputs": {
      "type": "object",
      "properties": {
        "input": {
          "type": "string",
          "x-ga4gh-file": {
            "kind": "file"
          },
          "description": "The input file to be processed."
        },
        "reverse_sort": {
          "type": "boolean",
          "description": "If true, reverse (descending) sort",
          "default": true
        }
      },
      "required": [
        "input"
      ],
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "properties": {
        "output": {
          "type": "string",
          "x-ga4gh-file": {
            "kind": "file"
          },
          "description": "The output with the lines reversed and sorted."
        }
      },
      "required": [
        "output"
      ]
    }
  }
}
